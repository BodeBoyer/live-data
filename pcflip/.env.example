# Copy to .env (or export in your shell). Nothing here is required to run the
# valuation engine; each block unlocks one automated feed.

# --- eBay Browse API (live price feed) -------------------------------------
# Create a free app at https://developer.ebay.com -> My Account -> Application Keys.
# Use the PRODUCTION keyset. Only client-credentials (no user login) is needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production          # or sandbox

# --- Alerts ----------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=                  # e.g. pcflip-yourname (uses https://ntfy.sh)

# --- Optional: Claude for spec extraction from messy prebuilt listings -----
ANTHROPIC_API_KEY=

# --- Optional: Apify hosted Facebook Marketplace scraper -------------------
APIFY_TOKEN=
APIFY_ACTOR_ID=              # e.g. raidr-api/facebook-marketplace-scraper
